# Postgres connection used by the API and migrations
DATABASE_URL=postgres://boh:boh@localhost:5432/boh
TEST_DATABASE_URL=postgres://boh:boh@localhost:5432/boh_test
# JWT signing secrets (use long random values in production)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
