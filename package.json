{
  "name": "boh",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @boh/db migrate",
    "dev": "pnpm --filter @boh/api dev"
  }
}